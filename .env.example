# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV="production"

# =====================================================================
# Database Configuration (PostgreSQL OR MySQL)
# If no database is configured, CalibTrack runs on the resilient in-memory
# laboratory store with 15 pre-configured instruments and full audit logs.
# =====================================================================

# Option A: PostgreSQL (Recommended for Vercel: Supabase, Neon, Vercel Postgres)
# Vercel Postgres and Supabase automatically provide POSTGRES_URL:
POSTGRES_URL="postgresql://postgres:password@ep-cool-project.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Or generic DATABASE_URL:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres?sslmode=require"

# Option B: MySQL (PlanetScale, AWS RDS, Aiven, or Self-Hosted)
# DATABASE_URL="mysql://root:password@localhost:3306/calibtrack"
# MYSQL_URL="mysql://root:password@localhost:3306/calibtrack"
# Or discrete variables:
# DB_HOST="localhost"
# DB_PORT=3306
# DB_USER="calibtrack_user"
# DB_PASSWORD="your_secure_password"
# DB_NAME="calibtrack"

# Connection Pool Limit (Keep low e.g. 5 for serverless microVMs)
DB_CONNECTION_LIMIT=5

# =====================================================================
# Security & Session Authentication
# =====================================================================
JWT_SECRET="generate_a_secure_random_string_for_jwt_tokens"
JWT_EXPIRES_IN="7d"

# =====================================================================
# Email Delivery Configuration (Resend API OR Standard SMTP)
# If neither is set, CalibTrack activates the on-screen lab inbox backup
# so verification codes and registration always succeed immediately.
# =====================================================================

# Option A: Resend API (Recommended for Vercel - instant HTTPS delivery)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
RESEND_FROM="CalibTrack Metrology <onboarding@resend.dev>"

# Option B: Standard SMTP Server (Gmail App Password, SendGrid, Amazon SES)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="lab-notifications@example.com"
SMTP_PASS="your_app_password"
SMTP_FROM="CalibTrack Laboratory <no-reply@calibtrack.lab>"
SMTP_SECURE="false"


